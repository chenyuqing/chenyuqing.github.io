---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => {
    const featuredSlug = 'how-to-read-this-site';
    if (a.id === featuredSlug) return -1;
    if (b.id === featuredSlug) return 1;
    return b.data.pubDate.getTime() - a.data.pubDate.getTime();
  })
  .slice(0, 3);
---

<BaseLayout title="Tim Chen · AI 时代网志" description="AI 时代的个人网志 — 博客与思考。" canonical="/">
  <main id="content" class="shell">
    <section class="home-hero reveal">
      <h1 class="home-hero-title" data-i18n="home_hero_title">在 AI 的浪里，搭一座慢站点</h1>
      <p class="home-hero-desc" data-i18n="home_intro_lead">关注 AI 创作工具、视频工作流和字幕产品，把复杂能力做成简单、可用、好玩的体验。</p>
      <div class="home-hero-actions">
        <a class="button button-primary" href="/blog/" data-i18n="home_hero_cta">浏览全部文章</a>
        <a class="button button-ghost" href="/about/" data-i18n="home_intro_about">关于我</a>
        <span class="home-hero-hint" data-i18n="home_intro_ai_hint">🤖 试试 AI 问答</span>
      </div>
    </section>

    <section class="home-blog-section reveal">
      <div class="home-list-topbar">
        <p class="home-list-label" data-i18n="home_list_label">最新文章</p>
        <div class="products-view-toggle home-view-toggle" role="radiogroup" aria-label="视图切换" data-aria-zh="视图切换" data-aria-en="View options">
          <button class="view-btn view-btn-active" data-view="list" aria-pressed="true" title="列表视图" data-title-zh="列表视图" data-title-en="List view">
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="4" x2="15" y2="4"/><line x1="3" y1="9" x2="15" y2="9"/><line x1="3" y1="14" x2="15" y2="14"/></svg>
          </button>
          <button class="view-btn" data-view="grid" aria-pressed="false" title="网格视图" data-title-zh="网格视图" data-title-en="Grid view">
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="1.5" width="6" height="6" rx="1.5"/><rect x="10.5" y="1.5" width="6" height="6" rx="1.5"/><rect x="1.5" y="10.5" width="6" height="6" rx="1.5"/><rect x="10.5" y="10.5" width="6" height="6" rx="1.5"/></svg>
          </button>
        </div>
      </div>
      <div class="magazine-list" id="home-blog-list" data-view="list">
          {blogPosts.length === 0 ? (
            <article class="magazine-card">
              <h2 data-i18n="home_blog_empty">暂无文章</h2>
              <p class="muted" data-i18n="home_blog_empty_hint">新文章正在路上。</p>
            </article>
          ) : (
          blogPosts.map((post, index) => (
            <article class={`magazine-card ${index === 0 ? 'magazine-card-featured' : ''}`}>
              {post.data.cover && (
                <a class="magazine-card-img-link" href={`/blog/${post.id}/`}>
                  <img class="magazine-card-img" src={post.data.cover} alt={post.data.title} />
                </a>
              )}
              <div class="magazine-card-body">
                <div class="magazine-card-eyebrow">
                  {post.data.verdict && (
                    <span class={`tag tag-verdict tag-verdict-${post.data.verdict}`}>{post.data.verdict}</span>
                  )}
                </div>
                <a class="magazine-card-title" href={`/blog/${post.id}/`}>
                  <h3>{post.data.title}</h3>
                </a>
                {post.data.description && (
                  <p class="magazine-card-desc">{post.data.description}</p>
                )}
                <div class="post-meta magazine-card-meta">
                  <span>{post.data.pubDate.toISOString().slice(0, 10)}</span>
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="tag tag-ai">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))
        )}
        </div>
    </section>

    <section class="home-contact-callout reveal">
      <div class="contact-callout-inner">
        <h2 class="contact-callout-title" data-i18n="home_contact_title">想一起做点有意思的东西？</h2>
        <p class="contact-callout-desc" data-i18n="home_contact_desc">欢迎交流产品、AI、设计和创作流程，我会持续更新这个站点。</p>
        <div class="contact-callout-actions">
          <a class="button button-callout" href="mailto:tim@dwyx.xyz" data-i18n="home_contact_email">发邮件</a>
          <a class="button button-callout-secondary" href="https://github.com/chenyuqing" target="_blank" rel="noreferrer" data-i18n="home_contact_github">GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <script is:inline>
    (function () {
      var list = document.getElementById('home-blog-list');
      var btns = document.querySelectorAll('.home-view-toggle .view-btn');
      if (!list || !btns.length) return;
      var apply = function (v) {
        list.setAttribute('data-view', v);
        btns.forEach(function (b) {
          var active = b.getAttribute('data-view') === v;
          b.classList.toggle('view-btn-active', active);
          b.setAttribute('aria-pressed', active);
        });
      };
      var saved = localStorage.getItem('home-blog-view');
      if (saved === 'grid' || saved === 'list') apply(saved);
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var v = btn.getAttribute('data-view');
          apply(v);
          localStorage.setItem('home-blog-view', v);
        });
      });
      var applyLang = function () {
        var en = document.documentElement.getAttribute('data-lang') === 'en';
        document.querySelectorAll('[data-title-zh]').forEach(function (node) {
          node.setAttribute('title', node.getAttribute(en ? 'data-title-en' : 'data-title-zh'));
        });
        document.querySelectorAll('[data-aria-zh]').forEach(function (node) {
          node.setAttribute('aria-label', node.getAttribute(en ? 'data-aria-en' : 'data-aria-zh'));
        });
      };
      applyLang();
      new MutationObserver(applyLang).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });
    })();
  </script>
</BaseLayout>
