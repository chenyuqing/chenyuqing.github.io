---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

// 尺寸预设：比例 + 用途场景，像素值与噜皮生图对齐（4:5 / 21:9 按同风格补齐）。
const sizePresets = [
  { value: 'auto', zh: '自动', en: 'Auto' },
  { value: '1024x1024', zh: '1:1 头像/商品', en: '1:1 Avatar/Product' },
  { value: '1024x1280', zh: '4:5 小红书/海报', en: '4:5 Social poster' },
  { value: '1024x1365', zh: '3:4 竖版作品', en: '3:4 Portrait art' },
  { value: '1024x1536', zh: '2:3 人物海报', en: '2:3 Character poster' },
  { value: '1536x1024', zh: '3:2 横版摄影', en: '3:2 Landscape photo' },
  { value: '1365x1024', zh: '4:3 配图/插画', en: '4:3 Illustration' },
  { value: '1920x1088', zh: '16:9 封面/视频', en: '16:9 Cover video' },
  { value: '1088x1920', zh: '9:16 手机/短视频', en: '9:16 Short video' },
  { value: '2688x1152', zh: '21:9 横幅/宽屏', en: '21:9 Ultrawide banner' },
];

// 内置提示词模板（【】内为主题占位，点击后替换成自己的主体）。
const presets = [
  {
    name: '毛绒玩偶',
    nameEn: 'Plush toy',
    prompt: '一只【主体】毛绒玩偶，柔软短绒材质，圆润可爱造型，坐在纯色背景前，柔和影棚灯光，轻微投影，3D 渲染，细节丰富',
  },
  {
    name: '微缩场景',
    nameEn: 'Diorama',
    prompt: '一个关于【主题】的等距微缩场景，精致小模型风格，柔和布光，浅景深，干净浅色背景，3D 渲染，超高细节',
  },
  {
    name: '绘本插画',
    nameEn: 'Storybook',
    prompt: '【主题】手绘儿童绘本插画，温暖柔和色调，蜡笔纹理，笔触松散可爱，米白纸张背景',
  },
  {
    name: '赛博朋克',
    nameEn: 'Cyberpunk',
    prompt: '夜晚的【城市】街道，赛博朋克风格，霓虹灯牌在雨后地面反光，行人与飞行器穿梭，电影感构图，高对比冷暖光',
  },
  {
    name: '产品图',
    nameEn: 'Product shot',
    prompt: '【产品】商业静物摄影，纯色背景，居中构图，柔和顶光，轻微投影，高级质感，广告级细节',
  },
  {
    name: '水彩画',
    nameEn: 'Watercolor',
    prompt: '【主题】水彩画，通透留白，晕染边缘，淡雅色调，纸纹肌理，横幅构图',
  },
  {
    name: '像素艺术',
    nameEn: 'Pixel art',
    prompt: '【主题】16-bit 像素艺术游戏画面，复古配色，精细像素排布，横版视角',
  },
  {
    name: '小红书封面',
    nameEn: 'RedNote cover',
    prompt: '小红书封面图，大号标题文字「【标题】」，【主题】背景，清新排版，留白呼吸感，暖色系配色',
  },
];
---

<BaseLayout title="AI 生图 · 工具" description="用自配 API 在线生成图片，默认模型 gpt-image-2，全部在浏览器完成。">
  <main id="content" class="tool-page">
    <section class="shell tool-top">
      <a class="tool-back" href="/tools/">
        <span class="lang-zh">← 返回工具箱</span>
        <span class="lang-en">← Back to Tools</span>
      </a>
      <p class="tool-eyebrow"><span class="lang-zh">图像工具</span><span class="lang-en">Image Utility</span></p>
      <h1><span class="lang-zh">AI 生图</span><span class="lang-en">AI Image Studio</span></h1>
      <p class="tool-lead">
        <span class="lang-zh">浏览器直连你自己的 OpenAI 兼容图片接口，默认模型 gpt-image-2。API 配置只保存在本机浏览器。</span>
        <span class="lang-en">Calls your own OpenAI-compatible image API straight from the browser, model gpt-image-2 by default. Credentials stay in this browser.</span>
      </p>
    </section>

    <section class="shell tool-panel">
      <div class="ig-grid">
      <div class="ig-left">
      <div class="settings-block">
        <button type="button" id="settings-toggle" class="settings-head" aria-expanded="false" aria-controls="settings-body">
          <span class="settings-title">
            <span class="lang-zh">接口设置</span><span class="lang-en">API settings</span>
          </span>
          <span class="settings-summary" id="settings-summary"></span>
          <b class="settings-caret" aria-hidden="true">▾</b>
        </button>
        <div id="settings-body" class="settings-body" hidden>
          <label class="field-row">
            <span class="field-label"><span class="lang-zh">Base URL</span><span class="lang-en">Base URL</span></span>
            <input id="cfg-base-url" type="url" placeholder="https://api.example.com/v1" autocomplete="off" spellcheck="false" />
          </label>
          <div class="field-row">
            <span class="field-label"><span class="lang-zh">API Key</span><span class="lang-en">API key</span></span>
            <span class="key-wrap">
              <input id="cfg-api-key" type="password" placeholder="sk-..." autocomplete="off" />
              <button type="button" id="key-visibility" class="key-eye" aria-label="显示密钥">👁</button>
            </span>
          </div>
          <div class="field-row">
            <span class="field-label"><span class="lang-zh">模型</span><span class="lang-en">Model</span></span>
            <div class="model-row">
              <div class="model-field">
                <input id="cfg-model" type="text" placeholder="gpt-image-2" value="gpt-image-2" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="model-menu" />
                <button type="button" id="model-menu-btn" class="model-menu-btn" tabindex="-1">▾</button>
                <div id="model-menu" class="model-menu" role="listbox" aria-label="Models" hidden></div>
              </div>
              <button type="button" id="model-fetch-btn" class="model-fetch">
                <span class="lang-zh">获取模型</span><span class="lang-en">Fetch</span>
              </button>
            </div>
          </div>
          <button type="button" id="proxy-toggle" class="proxy-toggle" aria-expanded="false" aria-controls="proxy-advanced">
            <span class="lang-zh">▸ 高级：CORS 代理</span><span class="lang-en">▸ Advanced: CORS proxy</span>
          </button>
          <div id="proxy-advanced" hidden>
            <label class="field-row">
              <span class="field-label"><span class="lang-zh">CORS 代理</span><span class="lang-en">CORS proxy</span></span>
              <input id="cfg-cors-proxy" type="url" value="https://imgen.wldss.shop/?url={url}" autocomplete="off" spellcheck="false" />
            </label>
            <p class="settings-note">
              <span class="lang-zh">已默认填写 Cloudflare 中转，&#123;url&#125; 会替换为编码后的接口地址；接口支持浏览器直连时可清空此项。本地调试也可先运行 npm run image:relay，改填 http://127.0.0.1:8789/proxy/&#123;url&#125;。密钥仅存于 localStorage，经代理时只作透传。</span>
              <span class="lang-en">A Cloudflare relay is prefilled; &#123;url&#125; is replaced with the encoded target URL. Clear it if your endpoint allows direct browser calls (CORS). For local debugging run npm run image:relay and use http://127.0.0.1:8789/proxy/&#123;url&#125;. The key is stored only in localStorage and merely passed through.</span>
            </p>
          </div>
        </div>
      </div>

      <div class="field-block">
        <div class="field-head">
          <label for="prompt-text" id="prompt-label">
            <span class="lang-zh">画面描述</span><span class="lang-en">Prompt</span>
          </label>
          <span class="field-meta" id="prompt-count">0</span>
        </div>
        <textarea id="prompt-text" rows="5" spellcheck="false" placeholder="描述想生成的画面，越具体越好…"></textarea>
        <div class="preset-row" aria-label="预设提示词">
          <span class="preset-label"><span class="lang-zh">预设</span><span class="lang-en">Presets</span></span>
          {presets.map((preset) => (
            <button type="button" class="preset-chip" data-prompt={preset.prompt}>
              <span class="lang-zh">{preset.name}</span>
              <span class="lang-en">{preset.nameEn}</span>
            </button>
          ))}
        </div>
        <div class="ref-row">
          <label class="ref-btn" for="ref-input">
            <span class="lang-zh">📎 上传参考图</span><span class="lang-en">📎 Add reference</span>
          </label>
          <input id="ref-input" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" multiple hidden />
          <span class="field-meta" id="ref-meta">
            <span class="lang-zh">选图后走「编辑图片」接口（最多 16 张）</span>
            <span class="lang-en">Images switch to the edits endpoint (up to 16)</span>
          </span>
        </div>
        <div class="ref-list" id="ref-list" hidden></div>
      </div>

      <div class="controls-row">
        <label class="control">
          <span class="control-label"><span class="lang-zh">尺寸</span><span class="lang-en">Size</span></span>
          <select id="cfg-size">
            {sizePresets.map((preset) => (
              <option value={preset.value} data-zh={preset.zh} data-en={preset.en}>{preset.zh}</option>
            ))}
          </select>
        </label>
        <label class="control">
          <span class="control-label"><span class="lang-zh">质量</span><span class="lang-en">Quality</span></span>
          <select id="cfg-quality">
            <option value="auto">auto</option>
            <option value="low">low</option>
            <option value="medium">medium</option>
            <option value="high">high</option>
          </select>
        </label>
      </div>

      <div class="action-row">
        <button class="tool-btn tool-btn-primary" type="button" id="btn-generate">
          <span class="lang-zh">生成图片</span><span class="lang-en">Generate</span>
        </button>
        <button class="tool-btn" type="button" id="btn-clear-prompt">
          <span class="lang-zh">清空描述</span><span class="lang-en">Clear prompt</span>
        </button>
      </div>

      <p class="status-line" id="status-line" aria-live="polite"></p>
      </div>

      <div class="ig-right">
      <div class="result-area" id="result-area">
        <div class="result-head">
          <span class="result-title"><span class="lang-zh">生成结果</span><span class="lang-en">Result</span></span>
          <span class="field-meta" id="result-meta"></span>
        </div>
        <div class="result-empty" id="result-empty">
          <p class="result-empty-icon" aria-hidden="true">▦</p>
          <p class="result-empty-hint">
            <span class="lang-zh">生成的图片会显示在这里。</span>
            <span class="lang-en">Your generated image will appear here.</span>
          </p>
        </div>
        <div class="result-frame" id="result-frame" hidden>
          <img id="result-img" alt="" />
        </div>
        <div class="action-row result-actions" id="result-actions" hidden>
          <a class="tool-btn tool-link" id="btn-open" href="#" target="_blank" rel="noreferrer" hidden>
            <span class="lang-zh">查看原图</span><span class="lang-en">View original</span>
          </a>
          <button class="tool-btn" type="button" id="btn-download">
            <span class="lang-zh">下载图片</span><span class="lang-en">Download</span>
          </button>
          <span class="result-stat">
            <span class="result-stat-label"><span class="lang-zh">图片尺寸</span><span class="lang-en">Dimensions</span></span>
            <b id="result-dims">—</b>
          </span>
          <span class="result-stat">
            <span class="result-stat-label"><span class="lang-zh">图片大小</span><span class="lang-en">File size</span></span>
            <b id="result-size">—</b>
          </span>
        </div>
      </div>
      </div>
      </div>
    </section>
  </main>

  <style>
    [hidden] { display: none !important; }
    .tool-page {
      min-height: 100dvh;
      padding: 6.2rem 0 4.5rem;
      background: #11100d;
      color: #eee4cc;
    }
    .tool-top { margin-bottom: 1.2rem; }
    .tool-back {
      display: inline-flex;
      margin-bottom: 1.1rem;
      color: #d1a843;
      text-decoration: none;
      font: 700 .78rem/1 var(--font-body);
      letter-spacing: .06em;
    }
    .tool-back:hover { color: #f0cf76; }
    .tool-eyebrow {
      margin: 0 0 .5rem;
      color: #b69a61;
      font: 700 .72rem/1.3 var(--font-body);
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .tool-top h1 {
      margin: 0 0 .65rem;
      color: #f4e8cb;
      font-size: clamp(2rem, 3.6vw, 2.8rem);
      line-height: 1;
    }
    .tool-lead {
      margin: 0;
      max-width: 42rem;
      color: #c9bda2;
      line-height: 1.65;
    }
    .tool-panel {
      border: 1px solid rgba(240, 223, 179, .22);
      border-radius: 10px;
      background: #1b1914;
      padding: 1.25rem;
    }

    /* two-column layout: params left, result right */
    .ig-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.15rem;
      align-items: start;
    }
    .ig-left, .ig-right { min-width: 0; }
    .ig-right {
      border: 1px solid rgba(240, 223, 179, .16);
      border-radius: 10px;
      background: #16130f;
      padding: 1rem;
    }
    @media (min-width: 980px) {
      .ig-grid { grid-template-columns: minmax(0, 1.12fr) minmax(0, .88fr); }
      .ig-right { position: sticky; top: 4.8rem; }
      .result-empty { min-height: 18rem; align-content: center; }
    }

    /* settings */
    .settings-block {
      margin-bottom: 1.15rem;
      border: 1px solid rgba(240, 223, 179, .16);
      border-radius: 8px;
      background: #16130f;
    }
    .settings-head {
      display: flex;
      width: 100%;
      align-items: center;
      gap: .7rem;
      padding: .8rem .95rem;
      border: 0;
      background: transparent;
      color: #e8dcc0;
      cursor: pointer;
      text-align: left;
    }
    .settings-head:hover .settings-title { color: #f0cf76; }
    .settings-title {
      font: 700 .8rem/1 var(--font-body);
      letter-spacing: .04em;
    }
    .settings-summary {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      color: #9d8f72;
      font: .75rem/1.3 var(--font-mono);
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .settings-caret { transition: transform .18s ease; }
    .settings-head[aria-expanded='true'] .settings-caret { transform: rotate(180deg); }
    .settings-body {
      display: grid;
      gap: .75rem;
      padding: .35rem .95rem .95rem;
    }
    .field-row {
      display: grid;
      gap: .35rem;
    }
    /* api key visibility */
    .key-wrap { position: relative; display: block; }
    .key-wrap input { padding-right: 2.7rem; }
    .key-eye {
      position: absolute;
      right: .55rem;
      top: 50%;
      transform: translateY(-50%);
      width: 1.9rem;
      height: 1.9rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 6px;
      background: transparent;
      font-size: .95rem;
      cursor: pointer;
      opacity: .75;
    }
    .key-eye:hover { opacity: 1; background: rgba(209, 168, 67, .14); }
    /* advanced proxy toggle */
    .proxy-toggle {
      justify-self: start;
      background: none;
      border: 1px solid rgba(240, 223, 179, .25);
      border-radius: 999px;
      color: #9d8f72;
      font-size: .78rem;
      padding: .28rem .75rem;
      cursor: pointer;
    }
    .proxy-toggle:hover { color: #f0cf76; border-color: #d1a843; }
    #proxy-advanced[hidden] { display: none; }
    /* model fetch */
    .model-row { display: flex; gap: .5rem; }
    .model-row input { flex: 1; min-width: 0; }
    .model-field { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; }
    .model-field input { padding-right: 2.4rem; }
    .model-menu-btn {
      position: absolute;
      right: .45rem;
      width: 1.7rem;
      height: 1.7rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 6px;
      background: transparent;
      color: #9d8f72;
      font-size: .8rem;
      cursor: pointer;
      transition: transform .18s ease, color .18s ease, background .18s ease;
    }
    .model-menu-btn:hover { color: #f0cf76; background: rgba(209, 168, 67, .14); }
    .model-menu-btn[aria-expanded='true'] { transform: rotate(180deg); color: #f0cf76; }
    .model-menu {
      position: absolute;
      top: calc(100% + .3rem);
      left: 0;
      right: 0;
      z-index: 40;
      max-height: 15rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      border: 1px solid rgba(240, 223, 179, .3);
      border-radius: 10px;
      background: #171410;
      box-shadow: 0 12px 28px rgba(0, 0, 0, .45);
      padding: .3rem;
    }
    .model-menu[hidden] { display: none; }
    .model-option {
      display: block;
      width: 100%;
      text-align: left;
      border: none;
      border-radius: 6px;
      background: transparent;
      color: #e9d9a8;
      font: .82rem/1.35 var(--font-mono);
      padding: .5rem .6rem;
      cursor: pointer;
      word-break: break-all;
    }
    .model-option:hover, .model-option.is-active { background: rgba(209, 168, 67, .16); color: #f7ecc9; }
    .model-option.is-current { color: #f0cf76; }
    .model-option.is-current::after { content: ' ✓'; }
    .model-menu-empty {
      margin: 0;
      padding: .55rem .6rem;
      color: #9d8f72;
      font: .78rem/1.4 var(--font-mono);
    }
    .model-fetch {
      white-space: nowrap;
      border: 1px solid rgba(240, 223, 179, .3);
      border-radius: 8px;
      background: #12100c;
      color: #e9d9a8;
      font-size: .8rem;
      padding: .55rem .85rem;
      cursor: pointer;
    }
    .model-fetch:hover:not(:disabled) { border-color: #d1a843; color: #f0cf76; }
    .model-fetch:disabled { opacity: .5; cursor: wait; }
    .field-label {
      color: #f0e2c0;
      font: 700 .78rem/1 var(--font-body);
      letter-spacing: .04em;
    }
    .settings-note {
      margin: 0;
      color: #9d8f72;
      font-size: .78rem;
      line-height: 1.55;
    }
    input, select {
      width: 100%;
      border: 1px solid rgba(240, 223, 179, .2);
      border-radius: 8px;
      background: #12100c;
      color: #f4e8cb;
      padding: .65rem .8rem;
      font: .9rem/1.4 var(--font-mono);
      outline: none;
    }
    input:focus, select:focus {
      border-color: #d1a843;
      box-shadow: 0 0 0 2px rgba(209, 168, 67, .18);
    }
    select { cursor: pointer; }

    /* prompt */
    .field-block { margin-bottom: 1rem; }
    .field-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: .45rem;
    }
    .field-head label {
      color: #f0e2c0;
      font: 700 .82rem/1 var(--font-body);
      letter-spacing: .04em;
    }
    .field-meta {
      color: #9d8f72;
      font: .75rem/1 var(--font-mono);
    }
    textarea {
      width: 100%;
      resize: vertical;
      min-height: 7.5rem;
      border: 1px solid rgba(240, 223, 179, .2);
      border-radius: 8px;
      background: #12100c;
      color: #f4e8cb;
      padding: .95rem 1rem;
      font: .95rem/1.55 var(--font-body);
      outline: none;
    }
    textarea:focus {
      border-color: #d1a843;
      box-shadow: 0 0 0 2px rgba(209, 168, 67, .18);
    }
    .preset-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: .45rem;
      margin-top: .65rem;
    }
    /* reference images */
    .ref-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: .7rem;
      margin-top: .8rem;
    }
    .ref-btn {
      display: inline-flex;
      align-items: center;
      padding: .42rem .85rem;
      border: 1px dashed rgba(240, 223, 179, .4);
      border-radius: 999px;
      font-size: .82rem;
      color: #e9d9a8;
      cursor: pointer;
      transition: border-color .15s ease, background .15s ease;
    }
    .ref-btn:hover { border-color: #d1a843; background: rgba(209, 168, 67, .12); }
    .ref-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
      gap: .55rem;
      margin-top: .75rem;
    }
    .ref-thumb {
      position: relative;
      aspect-ratio: 1 / 1;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid rgba(240, 223, 179, .25);
      background: #0d0b09;
    }
    .ref-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ref-thumb-remove {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: none;
      background: rgba(17, 16, 13, .82);
      color: #f0cf76;
      font-size: .78rem;
      line-height: 1;
      cursor: pointer;
    }
    .ref-thumb-remove:hover { background: #d1a843; color: #11100d; }
    .preset-label {
      color: #9d8f72;
      font: 700 .74rem/1 var(--font-body);
      letter-spacing: .06em;
    }
    .preset-chip {
      border: 1px solid rgba(240, 223, 179, .24);
      background: transparent;
      color: #e8dcc0;
      border-radius: 9999px;
      padding: .38rem .75rem;
      font: .76rem/1.2 var(--font-body);
      cursor: pointer;
    }
    .preset-chip:hover {
      border-color: #d1a843;
      color: #f0cf76;
    }
    .preset-chip.is-active {
      background: rgba(209, 168, 67, .16);
      border-color: #d1a843;
      color: #f0cf76;
    }

    /* controls & actions */
    .controls-row {
      display: flex;
      flex-wrap: wrap;
      gap: .8rem;
      margin-bottom: 1rem;
    }
    .control {
      display: grid;
      flex: 1 1 12rem;
      min-width: 0;
      gap: .35rem;
    }
    .control-label {
      color: #f0e2c0;
      font: 700 .78rem/1 var(--font-body);
      letter-spacing: .04em;
    }
    .action-row {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      margin: .2rem 0 1rem;
    }
    .result-panel .action-row { margin-bottom: 0; }
    .ig-right .action-row { margin: 0; }
    .result-stat {
      flex: 1 1 6.5rem;
      display: grid;
      justify-items: center;
      align-content: center;
      gap: .28rem;
      border: 1px solid rgba(240, 223, 179, .24);
      border-radius: 8px;
      background: transparent;
      padding: .45rem .6rem;
      text-align: center;
    }
    .result-stat-label {
      color: #9d8f72;
      font: 700 .68rem/1 var(--font-body);
      letter-spacing: .05em;
    }
    .result-stat b {
      color: #f4e8cb;
      font: 700 .82rem/1.2 var(--font-mono);
      word-break: break-all;
    }
    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(240, 223, 179, .24);
      background: transparent;
      color: #e8dcc0;
      border-radius: 8px;
      padding: .7rem 1rem;
      font: 700 .8rem/1 var(--font-body);
      letter-spacing: .04em;
      cursor: pointer;
      text-decoration: none;
    }
    .tool-btn:hover { border-color: #d1a843; color: #f0cf76; }
    .tool-btn-primary {
      background: #d1a843;
      border-color: #d1a843;
      color: #1a1408;
    }
    .tool-btn-primary:hover { filter: brightness(1.06); color: #1a1408; }
    .tool-btn:disabled {
      opacity: .55;
      cursor: progress;
      filter: none;
    }
    .status-line {
      min-height: 1.2rem;
      margin: .2rem 0 0;
      color: #b69a61;
      font-size: .85rem;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .status-line.is-error { color: #e18a7a; }
    .status-line.is-ok { color: #8fbf8a; }

    /* result */
    .result-area { min-width: 0; }
    .result-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: .6rem;
    }
    .result-title {
      color: #f0e2c0;
      font: 700 .82rem/1 var(--font-body);
      letter-spacing: .04em;
    }
    #result-meta {
      color: #9d8f72;
      font: .75rem/1 var(--font-mono);
    }
    .result-empty {
      display: grid;
      justify-items: center;
      gap: .55rem;
      border: 1px dashed rgba(240, 223, 179, .28);
      border-radius: 8px;
      background: #12100c;
      padding: 2rem 1rem;
      text-align: center;
    }
    .result-empty-icon {
      margin: 0;
      color: rgba(209, 168, 67, .45);
      font-size: 2rem;
      line-height: 1;
    }
    .result-empty-hint {
      max-width: 30rem;
      margin: 0;
      color: #9d8f72;
      font-size: .85rem;
      line-height: 1.65;
    }
    .result-frame {
      border: 1px solid rgba(240, 223, 179, .16);
      border-radius: 8px;
      background:
        radial-gradient(circle at 70% 20%, rgba(212, 160, 23, .1), transparent 45%),
        #12100c;
      padding: .8rem;
      margin-bottom: 1rem;
      text-align: center;
    }
    .result-frame img {
      display: inline-block;
      max-width: 100%;
      max-height: 70vh;
      height: auto;
      border-radius: 6px;
    }

    .lang-en { display: none; }
    :global(html[data-lang='en']) .lang-zh { display: none; }
    :global(html[data-lang='en']) .lang-en { display: inline; }
    @media (max-width: 720px) {
      .tool-page { padding: 4.4rem 0 3rem; }
      .tool-panel { padding: 1rem; }
      .action-row .tool-btn { flex: 1 1 calc(50% - .3rem); }
      .controls-row { flex-direction: column; }
      .control { flex-basis: auto; }
    }
  </style>

  <script>
    const root = document.documentElement;
    const STORAGE_KEY = 'image-gen-config-v1';

    const settingsToggle = document.getElementById('settings-toggle');
    const settingsBody = document.getElementById('settings-body');
    const settingsSummary = document.getElementById('settings-summary');
    const baseUrlInput = document.getElementById('cfg-base-url');
    const apiKeyInput = document.getElementById('cfg-api-key');
    const modelInput = document.getElementById('cfg-model');
    const corsProxyInput = document.getElementById('cfg-cors-proxy');
    const promptInput = document.getElementById('prompt-text');
    const promptCount = document.getElementById('prompt-count');
    const sizeSelect = document.getElementById('cfg-size');
    const qualitySelect = document.getElementById('cfg-quality');
    const generateBtn = document.getElementById('btn-generate');
    const clearPromptBtn = document.getElementById('btn-clear-prompt');
    const refInput = document.getElementById('ref-input');
    const refList = document.getElementById('ref-list');
    const refMeta = document.getElementById('ref-meta');
    const statusLine = document.getElementById('status-line');
    const resultArea = document.getElementById('result-area');
    const resultEmpty = document.getElementById('result-empty');
    const resultFrame = document.getElementById('result-frame');
    const resultActions = document.getElementById('result-actions');
    const resultMeta = document.getElementById('result-meta');
    const resultImg = document.getElementById('result-img');
    const resultDims = document.getElementById('result-dims');
    const resultSize = document.getElementById('result-size');
    const downloadBtn = document.getElementById('btn-download');
    const openLink = document.getElementById('btn-open');

    const isEn = () => root.getAttribute('data-lang') === 'en';
    const t = (zh, en) => (isEn() ? en : zh);

    let lastResult = null; // { kind: 'b64' | 'url', data }
    let timerId = null;

    const setStatus = (message, kind = '') => {
      statusLine.textContent = message;
      statusLine.classList.toggle('is-ok', kind === 'ok');
      statusLine.classList.toggle('is-error', kind === 'error');
    };

    /* ---- config persistence ---- */
    const DEFAULT_CORS_PROXY = 'https://imgen.wldss.shop/?url={url}';
    const LEGACY_CORS_PROXY = 'https://image-relay.motoleisure7983.workers.dev/?url={url}';
    const CONFIG_VERSION = 3; // v2: 引入代理默认值; v3: 默认中转迁到自定义域 imgen.wldss.shop

    const loadConfig = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) {
          corsProxyInput.value = DEFAULT_CORS_PROXY;
          return;
        }
        const c = JSON.parse(raw);
        if (typeof c.baseUrl === 'string') baseUrlInput.value = c.baseUrl;
        if (typeof c.apiKey === 'string') apiKeyInput.value = c.apiKey;
        if (typeof c.model === 'string' && c.model.trim()) modelInput.value = c.model.trim();
        if (c.configVersion === CONFIG_VERSION) {
          // 新版配置：用户改过代理就尊重（含故意清空）
          if (typeof c.corsProxy === 'string') corsProxyInput.value = c.corsProxy;
          else corsProxyInput.value = DEFAULT_CORS_PROXY;
        } else {
          // 旧版配置迁移：旧 workers.dev 默认值替换为新域名；用户自定义过的保留
          const stored =
            typeof c.corsProxy === 'string' && c.corsProxy.trim() && c.corsProxy !== LEGACY_CORS_PROXY
              ? c.corsProxy
              : DEFAULT_CORS_PROXY;
          corsProxyInput.value = stored;
          saveConfig();
        }
      } catch {}
    };

    const saveConfig = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          baseUrl: baseUrlInput.value.trim(),
          apiKey: apiKeyInput.value,
          model: modelInput.value.trim(),
          corsProxy: corsProxyInput.value.trim(),
        }));
      } catch {}
    };

    const updateSummary = () => {
      const base = baseUrlInput.value.trim();
      let host = t('未配置 Base URL', 'no base URL');
      if (base) {
        try {
          host = new URL(base).host;
        } catch {
          host = base.replace(/^https?:\/\//, '').split('/')[0] || base;
        }
      }
      const masked = apiKeyInput.value ? '••••' : t('无密钥', 'no key');
      const via = corsProxyInput.value.trim()
        ? t('代理', 'proxy')
        : t('直连', 'direct');
      settingsSummary.textContent = `${host} · ${modelInput.value.trim() || 'gpt-image-2'} · ${masked} · ${via}`;
    };

    [baseUrlInput, apiKeyInput, modelInput, corsProxyInput].forEach((el) => {
      el.addEventListener('change', () => {
        saveConfig();
        updateSummary();
        setStatus(t('设置已保存到本机。', 'Settings saved locally.'), 'ok');
      });
    });

    settingsToggle.addEventListener('click', () => {
      const nextOpen = settingsBody.hidden;
      settingsBody.hidden = !nextOpen;
      settingsToggle.setAttribute('aria-expanded', String(nextOpen));
    });

    /* ---- api key visibility & advanced proxy ---- */
    const keyVisibilityBtn = document.getElementById('key-visibility');
    const proxyToggle = document.getElementById('proxy-toggle');
    const proxyAdvanced = document.getElementById('proxy-advanced');

    keyVisibilityBtn.addEventListener('click', () => {
      const show = apiKeyInput.type === 'password';
      apiKeyInput.type = show ? 'text' : 'password';
      keyVisibilityBtn.textContent = show ? '🙈' : '👁';
      keyVisibilityBtn.setAttribute('aria-label', show ? t('隐藏密钥', 'Hide key') : t('显示密钥', 'Show key'));
    });

    proxyToggle.addEventListener('click', () => {
      const open = proxyAdvanced.hidden;
      proxyAdvanced.hidden = !open;
      proxyToggle.setAttribute('aria-expanded', String(open));
      proxyToggle.querySelector('.lang-zh').textContent = (open ? '▾ ' : '▸ ') + '高级：CORS 代理';
      proxyToggle.querySelector('.lang-en').textContent = (open ? '▾ ' : '▸ ') + 'Advanced: CORS proxy';
    });

    /* ---- model list fetching & custom dropdown ---- */
    const modelFetchBtn = document.getElementById('model-fetch-btn');
    const modelMenuBtn = document.getElementById('model-menu-btn');
    const modelMenu = document.getElementById('model-menu');
    const modelField = modelInput.closest('.model-field');

    let fetchedModels = [];
    let activeIndex = -1;

    const closeModelMenu = () => {
      modelMenu.hidden = true;
      modelInput.setAttribute('aria-expanded', 'false');
      modelMenuBtn.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
    };

    const applyActiveOption = () => {
      const options = modelMenu.querySelectorAll('.model-option');
      options.forEach((el, i) => {
        el.classList.toggle('is-active', i === activeIndex);
        if (i === activeIndex) el.scrollIntoView({ block: 'nearest' });
      });
    };

    const selectModel = (value) => {
      modelInput.value = value;
      saveConfig();
      updateSummary();
      closeModelMenu();
      setStatus(t(`已选择模型 ${value}。`, `Model set to ${value}.`), 'ok');
    };

    /* useFilter 仅在用户主动输入时为 true；打开/拉取列表时展示全部模型 */
    const renderModelMenu = (useFilter) => {
      const filter = useFilter ? modelInput.value.trim().toLowerCase() : '';
      const items = filter
        ? fetchedModels.filter((m) => m.toLowerCase().includes(filter))
        : fetchedModels;
      modelMenu.innerHTML = '';
      if (!items.length) {
        const p = document.createElement('p');
        p.className = 'model-menu-empty';
        p.textContent = t('没有匹配的模型，可直接输入任意模型名。', 'No matching models; type any name directly.');
        modelMenu.append(p);
        return;
      }
      const current = modelInput.value.trim().toLowerCase();
      items.forEach((mid) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'model-option' + (mid.toLowerCase() === current ? ' is-current' : '');
        btn.setAttribute('role', 'option');
        btn.textContent = mid;
        // mousedown 先于 input 的失焦，preventDefault 避免选项在 click 生效前被收起
        btn.addEventListener('mousedown', (e) => e.preventDefault());
        btn.addEventListener('click', () => selectModel(mid));
        modelMenu.append(btn);
      });
    };

    const syncMenuOpenState = (open) => {
      modelMenu.hidden = !open;
      modelInput.setAttribute('aria-expanded', String(open));
      modelMenuBtn.setAttribute('aria-expanded', String(open));
      if (!open) activeIndex = -1;
    };

    const openModelMenu = () => {
      if (!fetchedModels.length) return;
      renderModelMenu();
      syncMenuOpenState(true);
    };

    const toggleModelMenu = () => {
      if (!fetchedModels.length) {
        setStatus(t('先点「获取模型」拉取列表，再从这里下拉选择。', 'Fetch the model list first, then pick one from this dropdown.'), '');
        return;
      }
      renderModelMenu();
      syncMenuOpenState(modelMenu.hidden);
    };

    modelMenuBtn.addEventListener('click', toggleModelMenu);
    modelInput.addEventListener('focus', openModelMenu);
    modelInput.addEventListener('click', () => {
      // focus 已负责展开；这里只在意外收起时重新展开，避免「点一下就关」
      if (modelMenu.hidden) openModelMenu();
    });
    modelInput.addEventListener('input', () => {
      if (!fetchedModels.length) return;
      renderModelMenu(true);
      syncMenuOpenState(true);
    });
    modelInput.addEventListener('keydown', (event) => {
      if (modelMenu.hidden) return;
      const options = modelMenu.querySelectorAll('.model-option');
      if (!options.length) return;
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        activeIndex = Math.min(activeIndex + 1, options.length - 1);
        applyActiveOption();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        applyActiveOption();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const picked = activeIndex >= 0 && options[activeIndex] ? options[activeIndex].textContent : null;
        if (picked) selectModel(picked);
        else closeModelMenu();
      } else if (event.key === 'Escape') {
        closeModelMenu();
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (modelMenu.hidden) return;
      if (event.target instanceof Node && (modelMenu.contains(event.target) || modelField.contains(event.target))) return;
      closeModelMenu();
    });

    const fetchModels = async () => {
      if (!baseUrlInput.value.trim()) {
        setStatus(t('请先填写 Base URL 再获取模型。', 'Fill in the Base URL before fetching models.'), 'error');
        return;
      }
      modelFetchBtn.disabled = true;
      setStatus(t('正在获取模型列表…', 'Fetching models…'));
      try {
        const headers = {};
        if (apiKeyInput.value) headers.Authorization = `Bearer ${apiKeyInput.value}`;
        const res = await fetch(requestUrl('models'), { headers });
        if (!res.ok) {
          const message = await extractErrorMessage(res);
          setStatus(`${res.status}: ${String(message).slice(0, 240)}\n实际请求：${requestUrl('models')}`, 'error');
          return;
        }
        const json = await res.json();
        const ids = Array.isArray(json?.data) ? json.data.map((m) => m?.id).filter(Boolean) : [];
        fetchedModels = [...new Set(ids.map((id) => String(id)))];
        if (!fetchedModels.length) {
          setStatus(t('接口返回了空模型列表。', 'The endpoint returned an empty model list.'), 'error');
          return;
        }
        renderModelMenu();
        openModelMenu();
        setStatus(
          t(
            `已获取 ${fetchedModels.length} 个模型，下拉列表已展开，点击即可选择。`,
            `${fetchedModels.length} models fetched — the dropdown is open; click one to choose.`,
          ),
          'ok',
        );
      } catch (err) {
        setStatus(describeNetworkError('models', err, '获取模型失败。', 'Failed to fetch models.'), 'error');
      } finally {
        modelFetchBtn.disabled = false;
      }
    };
    modelFetchBtn.addEventListener('click', fetchModels);

    /* ---- generation ---- */
    const targetEndpoint = (path) => baseUrlInput.value.trim().replace(/\/+$/, '') + '/' + path;

    const requestUrl = (path) => {
      const target = targetEndpoint(path);
      const tpl = corsProxyInput.value.trim();
      if (!tpl) return target;
      return tpl.includes('{url}')
        ? tpl.replace('{url}', encodeURIComponent(target))
        : tpl + encodeURIComponent(target);
    };

    /* ---- failure diagnostics: surface the exact request URL and raw browser error ---- */
    const describeNetworkError = (path, err, prefixZh, prefixEn) => {
      let actual;
      try {
        actual = decodeURIComponent(requestUrl(path));
      } catch {
        actual = requestUrl(path);
      }
      const raw = err?.message || String(err);
      const opaque = /Failed to fetch|NetworkError|Load failed/i.test(raw);
      const hint = opaque
        ? t(
            '\n常见原因：① 代理不可用或被网络拦截；② Base URL 不对；③ 密钥无效被拒后的 CORS 挡板；④ 浏览器插件/系统代理干扰。',
            '\nCommon causes: (1) relay unreachable or blocked; (2) wrong Base URL; (3) CORS veil over an auth rejection; (4) browser extension or system proxy interference.',
          )
        : '';
      return t(prefixZh, prefixEn)
        + '\n实际请求：' + actual
        + '\n浏览器错误：' + raw
        + hint;
    };

    /* ---- reference images ---- */
    const MAX_REFS = 16;
    let referenceFiles = [];

    const renderRefs = () => {
      refList.innerHTML = '';
      refList.hidden = referenceFiles.length === 0;
      refMeta.style.display = referenceFiles.length ? 'none' : '';
      referenceFiles.forEach((file, idx) => {
        const cell = document.createElement('div');
        cell.className = 'ref-thumb';
        const img = document.createElement('img');
        img.src = file._previewUrl;
        img.alt = file.name;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ref-thumb-remove';
        btn.textContent = '×';
        btn.setAttribute('aria-label', t('移除参考图', 'Remove reference'));
        btn.addEventListener('click', () => {
          URL.revokeObjectURL(file._previewUrl);
          referenceFiles.splice(idx, 1);
          renderRefs();
        });
        cell.append(img, btn);
        refList.append(cell);
      });
    };

    refInput.addEventListener('change', () => {
      for (const file of Array.from(refInput.files || [])) {
        if (referenceFiles.length >= MAX_REFS) {
          setStatus(t(`参考图最多 ${MAX_REFS} 张，多余的已忽略。`, `Up to ${MAX_REFS} reference images; extra files ignored.`), 'error');
          break;
        }
        if (!/^image\/(jpeg|png|webp|gif)$/.test(file.type)) continue;
        file._previewUrl = URL.createObjectURL(file);
        referenceFiles.push(file);
      }
      refInput.value = '';
      renderRefs();
    });

    const extractErrorMessage = async (res) => {
      const text = await res.text();
      try {
        const json = JSON.parse(text);
        return json?.error?.message || json?.error || json?.message || text;
      } catch {
        return text;
      }
    };

    const startTimer = () => {
      const startedAt = Date.now();
      timerId = window.setInterval(() => {
        const seconds = Math.floor((Date.now() - startedAt) / 1000);
        setStatus(t(`正在生成图片… ${seconds}s`, `Generating image… ${seconds}s`));
      }, 1000);
    };

    const stopTimer = () => {
      if (timerId) {
        window.clearInterval(timerId);
        timerId = null;
      }
    };

    /* ---- result bottom bar: dimensions & file size ---- */
    const fmtBytes = (n) => {
      if (!Number.isFinite(n) || n <= 0) return '—';
      if (n >= 1024 * 1024) return `${(n / 1024 / 1024).toFixed(2)} MB`;
      if (n >= 1024) return `${(n / 1024).toFixed(1)} KB`;
      return `${n} B`;
    };

    const renderResultStats = () => {
      resultSize.textContent = fmtBytes(lastResult ? lastResult.byteSize : undefined);
    };

    resultImg.addEventListener('load', () => {
      resultDims.textContent = resultImg.naturalWidth
        ? `${resultImg.naturalWidth} × ${resultImg.naturalHeight}`
        : '—';
    });

    const showResult = (result) => {
      lastResult = result;
      resultImg.src = result.kind === 'b64' ? `data:image/png;base64,${result.data}` : result.data;
      openLink.hidden = result.kind !== 'url';
      if (result.kind === 'url') openLink.href = result.data;
      resultDims.textContent = '—';
      if (result.kind === 'b64') {
        try {
          result.byteSize = atob(result.data).length;
        } catch {
          result.byteSize = undefined;
        }
      } else {
        result.byteSize = undefined;
      }
      renderResultStats();
      const sizeText = sizeSelect.value === 'auto' ? t('自动尺寸', 'auto size') : sizeSelect.value;
      const qualityText = qualitySelect.selectedOptions[0]?.textContent?.trim() || qualitySelect.value;
      const modeText = referenceFiles.length ? t('参考图编辑', 'reference edit') : t('文生图', 'text-to-image');
      resultMeta.textContent = `${modelInput.value.trim() || 'gpt-image-2'} · ${sizeText} · ${qualityText} · ${modeText}`;
      resultEmpty.hidden = true;
      resultFrame.hidden = false;
      resultActions.hidden = false;
      resultArea?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const generate = async () => {
      if (!baseUrlInput.value.trim()) {
        setStatus(t('请先展开「接口设置」填写 Base URL 和 API Key。', 'Open “API settings” and fill in the Base URL and API key first.'), 'error');
        settingsBody.hidden = false;
        settingsToggle.setAttribute('aria-expanded', 'true');
        return;
      }
      const prompt = promptInput.value.trim();
      if (!prompt) {
        setStatus(t('请先输入画面描述。', 'Please describe the image first.'), 'error');
        return;
      }

      saveConfig();
      generateBtn.disabled = true;
      startTimer();
      setStatus(
        referenceFiles.length
          ? t(`正在基于 ${referenceFiles.length} 张参考图生成…`, `Generating from ${referenceFiles.length} reference image(s)…`)
          : t('正在生成图片…', 'Generating image…'),
      );

      try {
        let res;
        if (referenceFiles.length) {
          // 编辑模式：multipart/form-data 上传参考图（兼容 OpenAI Images edits）
          const fd = new FormData();
          fd.append('model', modelInput.value.trim() || 'gpt-image-2');
          fd.append('prompt', prompt);
          if (sizeSelect.value !== 'auto') fd.append('size', sizeSelect.value);
          fd.append('n', '1');
          // 不强制 response_format：各站点默认值不同（有的仅支持 url，有的仅 b64_json），
          // 交给服务端默认，两种返回我们都兼容
          referenceFiles.forEach((file) => fd.append('image', file, file.name));
          res = await fetch(requestUrl('images/edits'), {
            method: 'POST',
            headers: { Authorization: `Bearer ${apiKeyInput.value}` },
            body: fd,
          });
        } else {
          // 生成模式：JSON（OpenAI Images generations）
          res = await fetch(requestUrl('images/generations'), {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${apiKeyInput.value}`,
            },
            body: JSON.stringify({
              model: modelInput.value.trim() || 'gpt-image-2',
              prompt,
              size: sizeSelect.value,
              quality: qualitySelect.value,
              n: 1,
            }),
          });
        }

        if (!res.ok) {
          const message = await extractErrorMessage(res);
          let actual;
          try {
            actual = decodeURIComponent(requestUrl(referenceFiles.length ? 'images/edits' : 'images/generations'));
          } catch {
            actual = requestUrl(referenceFiles.length ? 'images/edits' : 'images/generations');
          }
          setStatus(`${res.status}: ${String(message).slice(0, 240)}\n实际请求：${actual}`, 'error');
          return;
        }

        const json = await res.json();
        const item = Array.isArray(json?.data) ? json.data[0] : null;
        if (item?.b64_json) {
          await finishGeneration({ kind: 'b64', data: item.b64_json });
        } else if (item?.url) {
          await finishGeneration({ kind: 'url', data: item.url });
        } else {
          setStatus(t('接口返回中没有图片数据。', 'The response contains no image data.'), 'error');
        }
      } catch (err) {
        setStatus(
          describeNetworkError(
            referenceFiles.length ? 'images/edits' : 'images/generations',
            err,
            '生成请求失败。',
            'Generation request failed.',
          ),
          'error',
        );
      } finally {
        stopTimer();
        generateBtn.disabled = false;
      }
    };

    /* ---- helpers ---- */
    const saveBlobDownload = (blob) => {
      const href = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = href;
      a.download = `image-gen-${Date.now()}.png`;
      document.body.append(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(href);
    };

    /* 返回 true 表示已触发下载；silent（自动下载）失败时不弹新标签，把控制权交还用户 */
    const download = async ({ silent } = {}) => {
      if (!lastResult) return false;
      if (lastResult.kind === 'b64') {
        const bin = atob(lastResult.data);
        saveBlobDownload(new Blob([Uint8Array.from(bin, (ch) => ch.charCodeAt(0))], { type: 'image/png' }));
        return true;
      }
      // 图片 URL 可能不带 CORS 头，先直连、失败后走用户配置的中转再试
      const attempts = [lastResult.data];
      const tpl = corsProxyInput.value.trim();
      if (tpl) {
        attempts.push(
          tpl.includes('{url}')
            ? tpl.replace('{url}', encodeURIComponent(lastResult.data))
            : tpl + encodeURIComponent(lastResult.data),
        );
      }
      for (const url of attempts) {
        try {
          const res = await fetch(url);
          if (!res.ok) continue;
          const blob = await res.blob();
          if (lastResult) {
            lastResult.byteSize = blob.size;
            renderResultStats();
          }
          saveBlobDownload(blob);
          return true;
        } catch {}
      }
      if (silent) return false;
      window.open(lastResult.data, '_blank', 'noreferrer');
      return true;
    };

    const finishGeneration = async (result) => {
      showResult(result);
      setStatus(t('生成完成，正在自动下载…', 'Generated — starting download…'), 'ok');
      const ok = await download({ silent: true });
      setStatus(
        ok
          ? t('生成完成，已自动开始下载；也可用下方按钮重新保存或打开原图。', 'Image generated and download started. Use the buttons below to save again or open the original.')
          : t(
              '生成完成。图片数据无法自动落盘（跨域或浏览器限制），请点「下载图片」或「新标签打开原图」。',
              'Image generated, but the automatic download was blocked (CORS or browser policy). Press “Download” or “Open original”.',
            ),
        ok ? 'ok' : '',
      );
    };

    generateBtn.addEventListener('click', generate);
    clearPromptBtn.addEventListener('click', () => {
      promptInput.value = '';
      promptCount.textContent = '0';
      clearActivePreset();
      setStatus(t('已清空描述。', 'Prompt cleared.'), 'ok');
    });
    downloadBtn.addEventListener('click', () => download());
    promptInput.addEventListener('input', () => {
      promptCount.textContent = String(promptInput.value.length);
    });
    promptInput.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') {
        event.preventDefault();
        generate();
      }
    });

    /* ---- preset prompts ---- */
    const presetChips = Array.from(document.querySelectorAll('.preset-chip'));
    const clearActivePreset = () => {
      presetChips.forEach((chip) => chip.classList.remove('is-active'));
    };
    presetChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const template = chip.dataset.prompt || '';
        promptInput.value = template;
        promptCount.textContent = String(template.length);
        clearActivePreset();
        chip.classList.add('is-active');
        setStatus(t('已填入预设模板，把【】里的内容替换成你的主体。', 'Preset filled. Replace the 【】 placeholders with your subject.'), 'ok');
        promptInput.focus();
      });
    });

    const applyMeta = () => {
      document.title = t('AI 生图 · 工具', 'AI Image Studio · Tools');
      modelMenuBtn.setAttribute('aria-label', t('展开或收起模型列表', 'Toggle the model list'));
      document.querySelector('meta[name="description"]')?.setAttribute(
        'content',
        t('用自配 API 在线生成图片，默认模型 gpt-image-2。', 'Generate images online via your own API, model gpt-image-2 by default.'),
      );
      promptInput.placeholder = t('描述想生成的画面，越具体越好…', 'Describe the image you want, the more specific the better…');
      // 原生 <option> 不受 CSS 显隐控制，选项文案随语言切换
      const qualityLabels = isEn()
        ? ['Auto', 'Low', 'Medium', 'High']
        : ['自动', '低', '中', '高'];
      Array.from(qualitySelect.options).forEach((opt, index) => {
        opt.textContent = qualityLabels[index] || opt.value;
      });
      Array.from(sizeSelect.options).forEach((opt) => {
        opt.textContent = isEn() ? (opt.dataset.en || opt.value) : (opt.dataset.zh || opt.value);
      });
    };

    loadConfig();
    updateSummary();
    applyMeta();
    new MutationObserver(applyMeta).observe(root, { attributes: true, attributeFilter: ['data-lang'] });
  </script>
</BaseLayout>
